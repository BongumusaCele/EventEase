@model IEnumerable<Event>

@{
    ViewData["Title"] = "Events";
}

<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1><i class="fas fa-calendar-alt" style="color: var(--primary); margin-right: 0.5rem;"></i>Event Management</h1>
            <p>Create and manage all your events</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-large">
            <span style="font-size: 1.2rem; margin-right: 0.5rem;">+</span> New Event
        </a>
    </div>
</div>

<!-- Filter Section -->
<form method="get" style="margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
    <input type="text" name="search" class="form-control" placeholder="Search events..." 
           style="flex: 1; max-width: 400px;" value="@(ViewBag.SearchTerm ?? "")" />
    <select name="venueId" asp-items="ViewBag.Venues" class="form-control" style="max-width: 250px;">
        <option value="">All Venues</option>
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Clear</a>
</form>

<!-- Events Table -->
@if (Model?.Any() ?? false)
{
    <div class="card">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th><i class="fas fa-calendar-alt"></i> Event Name</th>
                        <th><i class="fas fa-building"></i> Venue</th>
                        <th><i class="fas fa-clock"></i> Start Date</th>
                        <th><i class="fas fa-clock"></i> End Date</th>
                        <th><i class="fas fa-circle-info"></i> Description</th>
                        <th style="text-align: center;"><i class="fas fa-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(evt.ImageUrl))
                                {
                                    <img src="@evt.ImageUrl" alt="@evt.Name" style="width: 48px; height: 48px; object-fit: cover; border-radius: var(--radius); margin-right: 0.75rem; vertical-align: middle;" />
                                }
                                <strong>@evt.Name</strong>
                            </td>
                            <td>
                                @if (evt.Venue != null)
                                {
                                    <span class="badge" style="background: var(--primary-light); color: white;">
                                        @evt.Venue.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: #fee2e2; color: #991b1b;">
                                        <i class="fas fa-triangle-exclamation"></i> Not assigned
                                    </span>
                                }
                            </td>
                            <td>@evt.StartDateTime.ToString("MMM dd, yyyy")</td>
                            <td>@evt.EndDateTime.ToString("MMM dd, yyyy")</td>
                            <td>
                                @{
                                    var description = evt.Description ?? "";
                                    var shortDesc = description.Length > 30 ? description.Substring(0, 30) + "..." : description;
                                }
                                <small>@shortDesc</small>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                    <a asp-action="Details" asp-route-id="@evt.EventId" class="btn btn-small" style="background: var(--primary-light); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@evt.EventId" class="btn btn-small" style="background: var(--warning); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        <i class="fas fa-pen"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@evt.EventId" class="btn btn-small" style="background: var(--danger); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--gray-400);"><i class="fas fa-box-open"></i></div>
        <h2>No Events Found</h2>
        <p style="color: var(--gray-600); margin-bottom: 2rem;">Create your first event to get started.</p>
        <a asp-action="Create" class="btn btn-primary btn-large">Create Event</a>
    </div>
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
    }

    table tbody tr:hover {
        background-color: var(--gray-50);
    }

    .badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>
