@model Event
@{
    ViewData["Title"] = "Delete Event";
}

<partial name="_DeleteConfirmationStyles" />

<div class="confirm-delete-page">
    <section class="confirm-delete-card">
        <div class="confirm-delete-hero">
            <div class="confirm-delete-icon">
                <i class="fas @(ViewBag.HasLinkedBookings == true ? "fa-lock" : "fa-calendar-xmark")"></i>
            </div>
            <div class="confirm-delete-heading">
                <p class="confirm-delete-kicker">Delete event</p>
                <h1>@Model.Name</h1>
                <p>Review this event before permanently removing it from the schedule.</p>
            </div>
        </div>

        <div class="confirm-delete-body">
            @if (ViewBag.HasLinkedBookings == true)
            {
                <div class="confirm-delete-message blocked">
                    <i class="fas fa-lock"></i>
                    <div>
                        <strong>Deletion blocked</strong>
                        <p>This event is linked to existing bookings and cannot be deleted while booking records still reference it.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="confirm-delete-message warning">
                    <i class="fas fa-triangle-exclamation"></i>
                    <div>
                        <strong>This action cannot be undone</strong>
                        <p>Deleting this event permanently removes it from the event list.</p>
                    </div>
                </div>
            }

            <div class="confirm-delete-grid">
                <div class="confirm-delete-field">
                    <span>Venue</span>
                    <strong>@(Model.Venue != null ? Model.Venue.Name : "Not assigned")</strong>
                </div>
                <div class="confirm-delete-field">
                    <span>Status</span>
                    <strong>@(ViewBag.HasLinkedBookings == true ? "Has bookings" : "Ready to delete")</strong>
                </div>
                <div class="confirm-delete-field">
                    <span>Start</span>
                    <strong>@Model.StartDateTime.ToString("MMM dd, yyyy HH:mm")</strong>
                </div>
                <div class="confirm-delete-field">
                    <span>End</span>
                    <strong>@Model.EndDateTime.ToString("MMM dd, yyyy HH:mm")</strong>
                </div>
            </div>

            @if (ViewBag.HasLinkedBookings == true)
            {
                <div class="confirm-delete-actions">
                    <a class="btn btn-secondary" asp-action="Index">Back to Events</a>
                </div>
            }
            else
            {
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="EventId" />
                    <div class="confirm-delete-actions">
                        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                        <button class="btn btn-danger" type="submit">
                            <i class="fas fa-trash-alt" style="margin-right: 0.5rem;"></i>Delete Event
                        </button>
                    </div>
                </form>
            }
        </div>
    </section>
</div>
