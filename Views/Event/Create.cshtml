@model Event
@{
    ViewData["Title"] = "Create Event";
}

<h2>Create Event</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Venue (Optional)</label>
            <select asp-for="VenueId" asp-items="ViewBag.Venues" class="form-select">
                <option value="">-- Not assigned --</option>
            </select>
            <span asp-validation-for="VenueId" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="StartDateTime" class="form-label"></label>
            <input asp-for="StartDateTime" type="datetime-local" class="form-control"
                   value="@(Model?.StartDateTime.ToString("yyyy-MM-ddTHH:mm"))" />
            <span asp-validation-for="StartDateTime" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="EndDateTime" class="form-label"></label>
            <input asp-for="EndDateTime" type="datetime-local" class="form-control"
                   value="@(Model?.EndDateTime.ToString("yyyy-MM-ddTHH:mm"))" />
            <span asp-validation-for="EndDateTime" class="text-danger"></span>
        </div>

        <div class="col-12 mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div class="text-danger">@Html.ValidationSummary()</div>

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}