@model Venue
@{
    ViewData["Title"] = "Edit Venue";
}

<div style="max-width: 600px; margin: 0 auto;">
    <div class="page-header" style="text-align: center; margin-bottom: 3rem;">
        <h1><i class="fas fa-building" style="color: var(--primary); margin-right: 0.5rem;"></i>Edit Venue</h1>
        <p>Update your venue information</p>
    </div>

    <div class="card">
        <div style="padding: 2rem;">
            @if (!ViewData.ModelState.IsValid)
            {
                <partial name="_ValidationAlert" />
            }

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
    <input type="hidden" asp-for="VenueId" />

                <!-- Venue Name -->
                <div class="form-group">
                    <label class="form-label" asp-for="Name">
                        <i class="fas fa-circle-notch" style="color: var(--primary); margin-right: 0.5rem;"></i> Venue Name
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Grand Hotel Ballroom" />
                    <span asp-validation-for="Name" class="form-error"></span>
                    <small style="color: var(--gray-500); display: block; margin-top: 0.25rem;">Give your venue a memorable name</small>
    </div>

                <!-- Location -->
                <div class="form-group">
                    <label class="form-label" asp-for="Location">
                        <i class="fas fa-map-marker-alt" style="color: var(--primary); margin-right: 0.5rem;"></i> Location
                    </label>
                    <input asp-for="Location"
                           class="form-control"
                           placeholder="Search for a South African address or venue"
                           autocomplete="off"
                           data-address-search />
                    <span asp-validation-for="Location" class="form-error"></span>
                    <small style="color: var(--gray-500); display: block; margin-top: 0.25rem;">Start typing and select a South African address from the results.</small>
    </div>

                <!-- Capacity -->
                <div class="form-group">
                    <label class="form-label" asp-for="Capacity">
                        <i class="fas fa-users" style="color: var(--primary); margin-right: 0.5rem;"></i> Capacity
                    </label>
                    <input asp-for="Capacity" type="number" class="form-control" placeholder="e.g., 500" />
                    <span asp-validation-for="Capacity" class="form-error"></span>
                    <small style="color: var(--gray-500); display: block; margin-top: 0.25rem;">How many guests can your venue accommodate?</small>
    </div>

                <!-- Availability -->
                <div class="form-group" style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; background: var(--gray-50); border-radius: var(--radius);">
                    <input asp-for="IsAvailable" type="checkbox" style="margin-top: 0.25rem; width: 18px; height: 18px;" />
                    <div>
                        <label class="form-label" asp-for="IsAvailable" style="margin-bottom: 0.25rem;">
                            <i class="fas fa-circle-check" style="color: var(--primary); margin-right: 0.5rem;"></i> Available for bookings
                        </label>
                        <small style="color: var(--gray-500); display: block;">Mark whether this venue can currently be selected for bookings and filtering.</small>
                    </div>
    </div>

                <!-- Image Upload -->
                <div class="form-group">
                    <label class="form-label" for="imageFile">
                        <i class="fas fa-image" style="color: var(--primary); margin-right: 0.5rem;"></i> Venue Image
                    </label>
                    <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <span asp-validation-for="ImageUrl" class="form-error"></span>
                    <small style="color: var(--gray-500); display: block; margin-top: 0.25rem;">Upload a new image to replace the current Azure Storage image</small>
    </div>

                <!-- Form Actions -->
                <div style="display: flex; gap: 1rem; margin-top: 2rem; margin-bottom: 0;">
                    <button type="submit" class="btn btn-primary btn-large" style="flex: 1;">
                        <i class="fas fa-save" style="margin-right: 0.5rem;"></i>Update Venue
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-large" style="flex: 1;">
                        Cancel
                    </a>
                </div>
</form>
        </div>
    </div>

    <div style="text-align: center; margin-top: 2rem;">
        <a asp-action="Index" style="color: var(--primary); font-weight: 500;"><i class="fas fa-arrow-left" style="margin-right: 0.5rem;"></i>Back to Venues</a>
    </div>
</div>

<style>
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.75rem;
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid var(--gray-200);
        border-radius: var(--radius);
        font-size: 1rem;
        font-family: inherit;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .form-control::placeholder {
        color: var(--gray-400);
    }

    .form-error {
        color: var(--danger);
        font-size: 0.875rem;
        display: block;
        margin-top: 0.5rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
