@model IEnumerable<Venue>
@{
    ViewData["Title"] = "Venue";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Venues</h2>
    <a class="btn btn-primary" asp-action="Create">Create Venue</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Name</td>
                <td>@v.Location</td>
                <td>@v.Capacity</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.VenueId">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@v.VenueId">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.VenueId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
