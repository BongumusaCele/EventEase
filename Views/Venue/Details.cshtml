@model Venue
@{
    ViewData["Title"] = "Venue Details";
}

<div style="max-width: 700px; margin: 0 auto;">
    <div class="page-header" style="text-align: center; margin-bottom: 3rem;">
        <h1><i class="fas fa-building" style="color: var(--primary); margin-right: 0.5rem;"></i>Venue Details</h1>
        <p>View complete venue information and capacity</p>
    </div>

    <div class="card">
        <div style="padding: 2rem;">
            <!-- Venue Image (if available) -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div style="margin-bottom: 2rem; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-md); max-height: 300px;">
                    <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            }

            <!-- Venue Name -->
            <div style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 2px solid var(--gray-200);">
                <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                    <i class="fas fa-circle-notch" style="color: var(--primary); margin-right: 0.5rem;"></i>Venue Name
                </label>
                <h2 style="margin-top: 0.75rem; color: var(--gray-900); font-size: 2rem; font-weight: 700;">@Model.Name</h2>
            </div>

            <!-- Main Details Grid -->
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;">
                <!-- Location -->
                <div style="padding: 1.5rem; background: var(--gray-50); border-radius: var(--radius); border-left: 4px solid var(--primary);">
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-map-marker-alt" style="color: var(--primary); margin-right: 0.5rem;"></i>Location
                    </label>
                    <div style="margin-top: 0.75rem; font-size: 1.1rem; font-weight: 500; color: var(--gray-900);">@Model.Location</div>
                </div>

                <!-- Capacity -->
                <div style="padding: 1.5rem; background: var(--gray-50); border-radius: var(--radius); border-left: 4px solid var(--success);">
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-users" style="color: var(--success); margin-right: 0.5rem;"></i>Guest Capacity
                    </label>
                    <div style="margin-top: 0.75rem;">
                        <div style="font-size: 2rem; font-weight: 700; color: var(--success);">@Model.Capacity</div>
                        <div style="color: var(--gray-600); font-size: 0.875rem;">Maximum guests</div>
                    </div>
                </div>
            </div>

            <!-- Venue Features Card -->
            <div style="padding: 1.5rem; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: var(--radius); color: white; margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <i class="fas fa-star" style="font-size: 1.5rem;"></i>
                    <div>
                        <div style="font-weight: 600;">Premium Venue</div>
                        <div style="font-size: 0.875rem; opacity: 0.9; margin-top: 0.25rem;">Available for events and bookings</div>
                    </div>
                </div>
            </div>

            <!-- Image URL (if available) -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div style="padding: 1.5rem; background: var(--gray-50); border-radius: var(--radius); margin-bottom: 2rem; border-left: 4px solid var(--accent);">
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-image" style="color: var(--accent); margin-right: 0.5rem;"></i>Image URL
                    </label>
                    <div style="margin-top: 0.75rem; color: var(--gray-600); font-size: 0.875rem; word-break: break-all;">
                        <a href="@Model.ImageUrl" target="_blank" style="color: var(--primary);">@Model.ImageUrl</a>
    </div>
</div>
            }

            <!-- Action Buttons -->
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 2px solid var(--gray-200);">
                <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-primary" style="flex: 1; min-width: 150px;">
                    <i class="fas fa-edit" style="margin-right: 0.5rem;"></i> Edit Venue
                </a>
                <a asp-action="Index" class="btn btn-secondary" style="flex: 1; min-width: 150px;">
                    <i class="fas fa-arrow-left" style="margin-right: 0.5rem;"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>