@model Venue
@{
    ViewData["Title"] = "Venue Details";
}

<h2>Venue Details</h2>

<div class="card mt-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3">ImageUrl</dt>
            <dd class="col-sm-9">@Model.ImageUrl</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.VenueId">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</div>