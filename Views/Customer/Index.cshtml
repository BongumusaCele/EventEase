@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1><i class="fas fa-users" style="color: var(--primary); margin-right: 0.5rem;"></i>Customer Management</h1>
            <p>View and manage all your event customers</p>
</div>
        <a asp-action="Create" class="btn btn-primary btn-large">
            <span style="font-size: 1.2rem; margin-right: 0.5rem;">+</span> Add Customer
        </a>
    </div>
</div>

<!-- Search Bar -->
<div style="margin-bottom: 2rem;">
    <form method="get" style="display: flex; gap: 1rem;">
        <input type="text" name="search" class="form-control" placeholder="Search customers by name or email..." 
               style="flex: 1; max-width: 500px;" value="@(ViewBag.SearchTerm ?? "")" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="/Customer/Index" class="btn btn-secondary">Clear</a>
    </form>
</div>

<!-- Customers Table -->
@if (Model?.Any() ?? false)
{
    <div class="card">
        <div class="table-wrapper">
            <table>
    <thead>
        <tr>
                        <th><i class="fas fa-user"></i> Name</th>
                        <th><i class="fas fa-envelope"></i> Email</th>
                        <th><i class="fas fa-phone"></i> Phone</th>
                        <th style="text-align: center;"><i class="fas fa-gear"></i> Actions</th>
        </tr>
    </thead>
    <tbody>
                    @foreach (var customer in Model)
        {
            <tr>
                            <td>
                                <strong>@customer.Name</strong>
                            </td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                    <a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn btn-small" style="background: var(--primary-light); color: white; padding: 0.25rem 0.75rem;">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-small" style="background: var(--warning); color: white; padding: 0.25rem 0.75rem;">
                                        <i class="fas fa-pen"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@customer.CustomerId" class="btn btn-small" style="background: var(--danger); color: white; padding: 0.25rem 0.75rem;">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </div>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--gray-400);"><i class="fas fa-users-slash"></i></div>
        <h2>No Customers Found</h2>
        <p style="color: var(--gray-600); margin-bottom: 2rem;">Start by adding your first customer.</p>
        <a asp-action="Create" class="btn btn-primary btn-large">Add First Customer</a>
    </div>
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
    }

    table tbody tr:hover {
        background-color: var(--gray-50);
    }
</style>
