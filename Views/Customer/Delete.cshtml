@model Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<partial name="_DeleteConfirmationStyles" />

<div class="confirm-delete-page">
    <section class="confirm-delete-card">
        <div class="confirm-delete-hero">
            <div class="confirm-delete-icon">
                <i class="fas @(ViewBag.HasLinkedBookings == true ? "fa-lock" : "fa-user-xmark")"></i>
            </div>
            <div class="confirm-delete-heading">
                <p class="confirm-delete-kicker">Delete customer</p>
                <h1>@Model.Name</h1>
                <p>Review this customer profile before removing it from the system.</p>
            </div>
        </div>

        <div class="confirm-delete-body">
            @if (ViewBag.HasLinkedBookings == true)
            {
                <div class="confirm-delete-message blocked">
                    <i class="fas fa-lock"></i>
                    <div>
                        <strong>Deletion blocked</strong>
                        <p>This customer is linked to existing bookings and cannot be deleted while booking records still reference them.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="confirm-delete-message warning">
                    <i class="fas fa-triangle-exclamation"></i>
                    <div>
                        <strong>This action cannot be undone</strong>
                        <p>Deleting this customer permanently removes their profile from EventEase.</p>
                    </div>
                </div>
            }

            <div class="confirm-delete-grid">
                <div class="confirm-delete-field">
                    <span>Email</span>
                    <strong>@Model.Email</strong>
                </div>
                <div class="confirm-delete-field">
                    <span>Phone</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not supplied" : Model.Phone)</strong>
                </div>
            </div>

            @if (ViewBag.HasLinkedBookings == true)
            {
                <div class="confirm-delete-actions">
                    <a class="btn btn-secondary" asp-action="Index">Back to Customers</a>
                </div>
            }
            else
            {
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="CustomerId" />
                    <div class="confirm-delete-actions">
                        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                        <button class="btn btn-danger" type="submit">
                            <i class="fas fa-trash-alt" style="margin-right: 0.5rem;"></i>Delete Customer
                        </button>
                    </div>
                </form>
            }
        </div>
    </section>
</div>
