@model IEnumerable<User>

@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1>⚙️ User Management</h1>
            <p>Manage system users and their roles</p>
</div>
        <a asp-action="Create" class="btn btn-primary btn-large">
            <span style="font-size: 1.2rem; margin-right: 0.5rem;">+</span> Add User
        </a>
    </div>
</div>

<!-- Search & Filter -->
<div style="margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
    <input type="text" class="form-control" placeholder="🔍 Search by email..." 
           style="flex: 1; max-width: 400px;" />
    <select class="form-control" style="max-width: 200px;">
        <option value="">All Roles</option>
        <option value="Admin">👑 Admin</option>
        <option value="BookingSpecialist">📊 Booking Specialist</option>
        <option value="Customer">👤 Customer</option>
    </select>
</div>

<!-- Users Table -->
@if (Model?.Any() ?? false)
{
    <div class="card">
        <div class="table-wrapper">
            <table>
    <thead>
        <tr>
                        <th>📧 Email</th>
                        <th>🎭 Role</th>
                        <th>Status</th>
                        <th style="text-align: center;">⚙️ Actions</th>
        </tr>
    </thead>
    <tbody>
                    @foreach (var user in Model)
        {
                        var roleIcon = user.Role switch
                        {
                            "Admin" => "👑",
                            "BookingSpecialist" => "📊",
                            "Customer" => "👤",
                            _ => "❓"
                        };

                        var roleBadge = user.Role switch
                        {
                            "Admin" => "badge-primary",
                            "BookingSpecialist" => "badge-warning",
                            "Customer" => "badge-secondary",
                            _ => "badge-secondary"
                        };

            <tr>
                            <td>
                                <strong>@user.Email</strong>
                            </td>
                            <td>
                                <span class="badge @roleBadge">
                                    @roleIcon @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge" style="background: #dcfce7; color: #166534;">
                                    ✅ Active
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                    <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-small" style="background: var(--primary-light); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        👁️ View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-small" style="background: var(--warning); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        ✏️ Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-small" style="background: var(--danger); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        🗑️ Delete
                                    </a>
                                </div>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">👤</div>
        <h2>No Users Found</h2>
        <p style="color: var(--gray-600); margin-bottom: 2rem;">Add your first user to the system.</p>
        <a asp-action="Create" class="btn btn-primary btn-large">Create User</a>
    </div>
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
    }

    table tbody tr:hover {
        background-color: var(--gray-50);
    }

    .badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-align: center;
    }

    .badge-primary {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .badge-warning {
        background-color: #fef3c7;
        color: #92400e;
    }

    .badge-secondary {
        background-color: #e5e7eb;
        color: #374151;
    }
</style>