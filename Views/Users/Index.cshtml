@model IEnumerable<User>

@{
    ViewData["Title"] = "Users";
    var selectedRole = ViewBag.SelectedRole as string ?? "";
    var adminSelected = selectedRole == "Admin";
    var bookingSpecialistSelected = selectedRole == "BookingSpecialist";
    var customerSelected = selectedRole == "Customer";
}

<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1><i class="fas fa-gear" style="color: var(--primary); margin-right: 0.5rem;"></i>User Management</h1>
            <p>Manage system users and their roles</p>
</div>
        <a asp-action="Create" class="btn btn-primary btn-large">
            <span style="font-size: 1.2rem; margin-right: 0.5rem;">+</span> Add User
        </a>
    </div>
</div>

<!-- Search & Filter -->
<form method="get" style="margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
    <input type="text" name="search" class="form-control" placeholder="Search by email..." 
           style="flex: 1; max-width: 400px;" value="@(ViewBag.SearchTerm ?? "")" />
    <select name="role" class="form-control" style="max-width: 260px;">
        <option value="">All Roles</option>
        <option value="Admin" selected="@adminSelected">Admin</option>
        <option value="BookingSpecialist" selected="@bookingSpecialistSelected">Booking Specialist</option>
        <option value="Customer" selected="@customerSelected">Customer</option>
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Clear</a>
</form>

<!-- Users Table -->
@if (Model?.Any() ?? false)
{
    <div class="card">
        <div class="table-wrapper">
            <table>
    <thead>
        <tr>
                        <th><i class="fas fa-envelope"></i> Email</th>
                        <th><i class="fas fa-user-shield"></i> Role</th>
                        <th>Status</th>
                        <th style="text-align: center;"><i class="fas fa-gear"></i> Actions</th>
        </tr>
    </thead>
    <tbody>
                    @foreach (var user in Model)
        {
                        var roleIcon = user.Role switch
                        {
                            "Admin" => "fa-user-shield",
                            "BookingSpecialist" => "fa-clipboard-list",
                            "Customer" => "fa-user",
                            _ => "fa-circle-question"
                        };

                        var roleBadge = user.Role switch
                        {
                            "Admin" => "badge-primary",
                            "BookingSpecialist" => "badge-warning",
                            "Customer" => "badge-secondary",
                            _ => "badge-secondary"
                        };

            <tr>
                            <td>
                                <strong>@user.Email</strong>
                            </td>
                            <td>
                                <span class="badge @roleBadge">
                                    <i class="fas @roleIcon"></i> @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge" style="background: #dcfce7; color: #166534;">
                                    <i class="fas fa-circle-check"></i> Active
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                    <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-small" style="background: var(--primary-light); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-small" style="background: var(--warning); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        <i class="fas fa-pen"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-small" style="background: var(--danger); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </div>
                </td>
            </tr>
        }
    </tbody>
</table>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--gray-400);"><i class="fas fa-user-slash"></i></div>
        <h2>No Users Found</h2>
        <p style="color: var(--gray-600); margin-bottom: 2rem;">Add your first user to the system.</p>
        <a asp-action="Create" class="btn btn-primary btn-large">Create User</a>
    </div>
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
    }

    table tbody tr:hover {
        background-color: var(--gray-50);
    }

    .badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-align: center;
    }

    .badge-primary {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .badge-warning {
        background-color: #fef3c7;
        color: #92400e;
    }

    .badge-secondary {
        background-color: #e5e7eb;
        color: #374151;
    }
</style>
