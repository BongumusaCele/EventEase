@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 600px; margin: 4rem auto; text-align: center;">
    <div style="font-size: 4rem; margin-bottom: 1rem; color: var(--danger);"><i class="fas fa-lock"></i></div>
    <h1>Access Denied</h1>
    <p style="color: var(--gray-600); font-size: 1.1rem; margin: 1rem 0 2rem 0;">
        You don't have permission to access this resource. If you believe this is a mistake, please contact support.
    </p>
    
    <div>
        <a href="/" class="btn btn-primary"><i class="fas fa-house" style="margin-right: 0.5rem;"></i>Go to Home</a>
        <a href="javascript:history.back()" class="btn btn-secondary"><i class="fas fa-arrow-left" style="margin-right: 0.5rem;"></i>Go Back</a>
    </div>
</div>
