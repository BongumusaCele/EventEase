@model Booking
@{
    ViewData["Title"] = "Delete Booking";
}

<h2>Delete Booking</h2>

<div class="alert alert-warning mt-3">
    Are you sure you want to delete Booking <strong>#@Model.BookingId</strong>?
</div>

<ul class="list-group mb-3">
    <li class="list-group-item"><strong>Venue:</strong> @Model.Venue?.Name</li>
    <li class="list-group-item"><strong>Event:</strong> @Model.Event?.Name</li>
    <li class="list-group-item"><strong>Customer:</strong> @Model.Customer?.Name</li>
    <li class="list-group-item"><strong>Start:</strong> @Model.StartDateTime</li>
    <li class="list-group-item"><strong>End:</strong> @Model.EndDateTime</li>
</ul>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BookingId" />
    <button class="btn btn-danger" type="submit">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>