@model IEnumerable<EventEase.Models.BookingDetailsView>

@{
    ViewData["Title"] = "Bookings";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var selectedVenueAvailability = ViewBag.SelectedVenueAvailable as string ?? "";
}

<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div>
            <h1>Booking Management</h1>
            <p>Search and manage enriched booking information from bookings, venues, events, customers, and specialists</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-large">
            <span style="font-size: 1.2rem; margin-right: 0.5rem;">+</span> New Booking
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.FilterError as string))
{
    <div class="alert alert-danger" style="margin-bottom: 1rem;">@ViewBag.FilterError</div>
}

<form method="get" asp-action="Index" style="margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
    <input type="text"
           name="search"
           value="@searchTerm"
           class="form-control"
           placeholder="Search by Booking ID or Event Name"
           style="flex: 1; min-width: 220px; max-width: 360px;" />
    <select name="eventTypeId" asp-items="ViewBag.EventTypes" class="form-control" style="min-width: 190px; max-width: 240px;">
        <option value="">All Event Types</option>
    </select>
    <input type="date"
           name="startDate"
           value="@(ViewBag.StartDate ?? "")"
           class="form-control"
           style="min-width: 160px; max-width: 190px;"
           aria-label="Booking start date" />
    <input type="date"
           name="endDate"
           value="@(ViewBag.EndDate ?? "")"
           class="form-control"
           style="min-width: 160px; max-width: 190px;"
           aria-label="Booking end date" />
    <select name="venueAvailable" class="form-control" style="min-width: 190px; max-width: 230px;">
        <option value="">All Venue Availability</option>
        @if (selectedVenueAvailability == "true")
        {
            <option value="true" selected>Available Venues</option>
            <option value="false">Unavailable Venues</option>
        }
        else if (selectedVenueAvailability == "false")
        {
            <option value="true">Available Venues</option>
            <option value="false" selected>Unavailable Venues</option>
        }
        else
        {
            <option value="true">Available Venues</option>
            <option value="false">Unavailable Venues</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Clear</a>
</form>

@if (Model?.Any() ?? false)
{
    <div class="card">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Booking</th>
                        <th>Event</th>
                        <th>Type</th>
                        <th>Venue</th>
                        <th>Customer</th>
                        <th>Specialist</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        var statusBadge = booking.Status switch
                        {
                            "Pending" => "badge-warning",
                            "Confirmed" => "badge-success",
                            "Completed" => "badge-primary",
                            "Cancelled" => "badge-danger",
                            _ => "badge-secondary"
                        };

                        <tr>
                            <td><strong>#@booking.BookingId</strong></td>
                            <td>
                                <strong>@booking.EventName</strong>
                                <div style="color: var(--gray-600); font-size: 0.8rem;">
                                    @booking.EventStartDateTime.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-primary">@booking.EventTypeName</span>
                            </td>
                            <td>
                                <strong>@booking.VenueName</strong>
                                <div style="color: var(--gray-600); font-size: 0.8rem;">
                                    @booking.VenueLocation
                                </div>
                                <div style="color: var(--gray-600); font-size: 0.8rem;">
                                    Capacity: @booking.VenueCapacity
                                </div>
                                <div style="font-size: 0.8rem; color: @(booking.VenueIsAvailable ? "#166534" : "#991b1b");">
                                    @(booking.VenueIsAvailable ? "Available" : "Unavailable")
                                </div>
                            </td>
                            <td>
                                <strong>@booking.CustomerName</strong>
                                <div style="color: var(--gray-600); font-size: 0.8rem;">@booking.CustomerEmail</div>
                            </td>
                            <td>@booking.BookingSpecialistEmail</td>
                            <td>
                                <div>@booking.BookingStartDateTime.ToString("MMM dd, yyyy HH:mm")</div>
                                <div style="color: var(--gray-600); font-size: 0.8rem;">
                                    to @booking.BookingEndDateTime.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                <span class="badge @statusBadge">@booking.Status</span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
                                    <a asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-small" style="background: var(--primary-light); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-small" style="background: var(--warning); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@booking.BookingId" class="btn btn-small" style="background: var(--danger); color: white; padding: 0.25rem 0.75rem; font-size: 0.75rem;">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <h2>No Bookings Found</h2>
        <p style="color: var(--gray-600); margin-bottom: 2rem;">Try another search term or create a new booking.</p>
        <a asp-action="Create" class="btn btn-primary btn-large">Create Booking</a>
    </div>
}

<style>
    .page-header {
        margin-bottom: 2.5rem;
    }

    table tbody tr:hover {
        background-color: var(--gray-50);
    }

    .badge {
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-warning {
        background-color: #fef3c7;
        color: #92400e;
    }

    .badge-success {
        background-color: #dcfce7;
        color: #166534;
    }

    .badge-primary {
        background-color: #dbeafe;
        color: #1e40af;
    }

    .badge-danger {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .badge-secondary {
        background-color: var(--gray-200);
        color: var(--gray-700);
    }
</style>
