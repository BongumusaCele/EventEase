@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Bookings</h2>
    <a class="btn btn-primary" asp-action="Create">Create Booking</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Venue</th>
            <th>Event</th>
            <th>Customer</th>
            <th>User</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.BookingId</td>
                <td>@b.Venue?.Name</td>
                <td>@b.Event?.Name</td>
                <td>@b.Customer?.Name</td>
                <td>@b.User?.Email</td>
                <td>@b.StartDateTime</td>
                <td>@b.EndDateTime</td>
                <td>@b.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.BookingId">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.BookingId">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.BookingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>