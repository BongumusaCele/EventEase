@model EventEase.Models.Dtos.BookingForm
@{
    ViewData["Title"] = "Edit Booking";
}

<h2>Edit Booking</h2>

<form asp-action="Edit" method="post" class="mt-3">
    <input type="hidden" asp-for="BookingId" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Venue</label>
            <select asp-for="VenueId" asp-items="Model.Venues" class="form-select"></select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Event</label>
            <select asp-for="EventId" asp-items="Model.Events" class="form-select"></select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Customer</label>
            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"></select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">User</label>
            <select asp-for="UserId" asp-items="Model.Users" class="form-select"></select>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="StartDateTime" class="form-label"></label>
            <input asp-for="StartDateTime" type="datetime-local" class="form-control"
                   value="@Model.StartDateTime.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="EndDateTime" class="form-label"></label>
            <input asp-for="EndDateTime" type="datetime-local" class="form-control"
                   value="@Model.EndDateTime.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Status" class="form-label"></label>
            <input asp-for="Status" class="form-control" />
        </div>
    </div>

    <div class="text-danger">@Html.ValidationSummary()</div>

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}