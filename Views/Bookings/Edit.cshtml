@model EventEase.Models.Dtos.BookingForm
@{
    ViewData["Title"] = "Edit Booking";
}

<div style="max-width: 700px; margin: 0 auto;">
    <div class="page-header" style="text-align: center; margin-bottom: 3rem;">
        <h1><i class="fas fa-clipboard-list" style="color: var(--primary); margin-right: 0.5rem;"></i>Edit Booking</h1>
        <p>Update booking details</p>
    </div>

    <div class="card">
        <div style="padding: 2rem;">
            @if (!ViewData.ModelState.IsValid)
            {
                <partial name="_ValidationAlert" />
            }

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BookingId" />

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-building"></i></span> Select Venue
                    </label>
                    <select asp-for="VenueId" asp-items="Model.Venues" class="form-control" style="padding: 0.75rem; border: 2px solid var(--gray-200); border-radius: var(--radius); cursor: pointer;">
                        <option value="">-- Choose a venue --</option>
                    </select>
                    <span asp-validation-for="VenueId" class="form-error"></span>
                    <small>Pick the venue where this booking will be held</small>
        </div>

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-calendar-alt"></i></span> Select Event
                    </label>
                    <select asp-for="EventId" asp-items="Model.Events" class="form-control" style="padding: 0.75rem; border: 2px solid var(--gray-200); border-radius: var(--radius); cursor: pointer;">
                        <option value="">-- Choose an event --</option>
                    </select>
                    <span asp-validation-for="EventId" class="form-error"></span>
                    <small>Which event is this booking for?</small>
        </div>

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-user"></i></span> Select Customer
                    </label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-control" style="padding: 0.75rem; border: 2px solid var(--gray-200); border-radius: var(--radius); cursor: pointer;">
                        <option value="">-- Choose a customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="form-error"></span>
                    <small>Who is making this booking?</small>
        </div>

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-user-tie"></i></span> Booking Specialist
                    </label>
                    <select asp-for="UserId" asp-items="Model.Users" class="form-control" style="padding: 0.75rem; border: 2px solid var(--gray-200); border-radius: var(--radius); cursor: pointer;">
                        <option value="">-- Assign specialist --</option>
                    </select>
                    <span asp-validation-for="UserId" class="form-error"></span>
                    <small>Who is managing this booking?</small>
        </div>

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-calendar-alt"></i></span> Start Date & Time
                    </label>
            <input asp-for="StartDateTime" type="datetime-local" class="form-control"
                   value="@Model.StartDateTime?.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="StartDateTime" class="form-error"></span>
                    <small>When does the booking begin?</small>
        </div>

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-clock"></i></span> End Date & Time
                    </label>
            <input asp-for="EndDateTime" type="datetime-local" class="form-control"
                   value="@Model.EndDateTime?.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="EndDateTime" class="form-error"></span>
                    <small>When does the booking end?</small>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <span style="font-size: 1.2rem;"><i class="fas fa-check-circle"></i></span> Booking Status
                    </label>
                    <select asp-for="Status" class="form-control" style="padding: 0.75rem; border: 2px solid var(--gray-200); border-radius: var(--radius); cursor: pointer;">
                        <option value="">-- Select status --</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="form-error"></span>
                    <small>What's the current status of this booking?</small>
                </div>

                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <button type="submit" style="flex: 1; padding: 0.875rem 1.5rem; background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%); color: white; border: none; border-radius: var(--radius); font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(99, 102, 241, 0.2);">
                        <i class="fas fa-save" style="margin-right: 0.5rem;"></i>Update Booking
                    </button>
                    <a asp-action="Index" style="flex: 1; padding: 0.875rem 1.5rem; background-color: var(--gray-200); color: var(--gray-800); border: none; border-radius: var(--radius); font-size: 1rem; font-weight: 600; cursor: pointer; text-decoration: none; text-align: center; transition: all 0.3s ease;">
                        <i class="fas fa-times" style="margin-right: 0.5rem;"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
        </div>

    <div style="text-align: center; margin-top: 2rem;">
        <a asp-action="Index" style="color: var(--primary); font-weight: 500;"><i class="fas fa-arrow-left" style="margin-right: 0.5rem;"></i>Back to Bookings</a>
        </div>
    </div>

<style>
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.75rem;
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid var(--gray-200);
        border-radius: var(--radius);
        font-size: 1rem;
        font-family: inherit;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .form-control::placeholder {
        color: var(--gray-400);
    }

    .form-error {
        color: var(--danger);
        display: block;
        font-size: 0.875rem;
        margin-top: 0.5rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
