@model Booking
@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>

<div class="card mt-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">BookingId</dt>
            <dd class="col-sm-9">@Model.BookingId</dd>

            <dt class="col-sm-3">Venue</dt>
            <dd class="col-sm-9">@Model.Venue?.Name</dd>

            <dt class="col-sm-3">Event</dt>
            <dd class="col-sm-9">@Model.Event?.Name</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.Customer?.Name</dd>

            <dt class="col-sm-3">User</dt>
            <dd class="col-sm-9">@Model.User?.Email</dd>

            <dt class="col-sm-3">Start</dt>
            <dd class="col-sm-9">@Model.StartDateTime</dd>

            <dt class="col-sm-3">End</dt>
            <dd class="col-sm-9">@Model.EndDateTime</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.BookingId">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</div>