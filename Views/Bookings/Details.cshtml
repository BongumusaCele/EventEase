@model Booking
@{
    ViewData["Title"] = "Booking Details";
}

<div style="max-width: 700px; margin: 0 auto;">
    <div class="page-header" style="text-align: center; margin-bottom: 3rem;">
        <h1><i class="fas fa-clipboard-list" style="color: var(--primary); margin-right: 0.5rem;"></i>Booking Details</h1>
        <p>Review complete booking information</p>
    </div>

    <div class="card">
        <div style="padding: 2rem;">
            <!-- Booking ID & Status -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 2px solid var(--gray-200);">
                <div>
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Booking ID</label>
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary); margin-top: 0.5rem;">#@Model.BookingId</div>
                </div>
                <div>
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">Status</label>
                    <div style="margin-top: 0.5rem;">
                        @{
                            var statusColor = Model.Status switch
                            {
                                "Pending" => "#f59e0b",
                                "Confirmed" => "#10b981",
                                "Completed" => "#6366f1",
                                "Cancelled" => "#ef4444",
                                _ => "#6b7280"
                            };
                            var statusIcon = Model.Status switch
                            {
                                "Pending" => "fa-hourglass-half",
                                "Confirmed" => "fa-check-circle",
                                "Completed" => "fa-party-horn",
                                "Cancelled" => "fa-times-circle",
                                _ => "fa-question-circle"
                            };
                        }
                        <span style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(@statusColor, 0.1); color: @statusColor; padding: 0.5rem 1rem; border-radius: var(--radius); font-weight: 600;">
                            <i class="fas @statusIcon"></i> @Model.Status
                        </span>
                    </div>
                </div>
            </div>

            <!-- Main Details Grid -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
                <!-- Venue -->
                <div>
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-building" style="color: var(--primary); margin-right: 0.5rem;"></i>Venue
                    </label>
                    <div style="margin-top: 0.75rem; font-size: 1.1rem; font-weight: 500; color: var(--gray-900);">@Model.Venue?.Name</div>
                    <div style="margin-top: 0.25rem; color: var(--gray-600); font-size: 0.875rem;">@Model.Venue?.Location</div>
                </div>

                <!-- Event -->
                <div>
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-calendar-alt" style="color: var(--primary); margin-right: 0.5rem;"></i>Event
                    </label>
                    <div style="margin-top: 0.75rem; font-size: 1.1rem; font-weight: 500; color: var(--gray-900);">@Model.Event?.Name</div>
                </div>

                <!-- Customer -->
                <div>
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-user" style="color: var(--primary); margin-right: 0.5rem;"></i>Customer
                    </label>
                    <div style="margin-top: 0.75rem; font-size: 1.1rem; font-weight: 500; color: var(--gray-900);">@Model.Customer?.Name</div>
                    <div style="margin-top: 0.25rem; color: var(--gray-600); font-size: 0.875rem;">@Model.Customer?.Email</div>
                </div>

                <!-- Booking Specialist -->
                <div>
                    <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <i class="fas fa-user-tie" style="color: var(--primary); margin-right: 0.5rem;"></i>Specialist
                    </label>
                    <div style="margin-top: 0.75rem; font-size: 1.1rem; font-weight: 500; color: var(--gray-900);">@Model.User?.Email</div>
                </div>
            </div>

            <!-- Dates Section -->
            <div style="padding: 1.5rem; background: var(--gray-50); border-radius: var(--radius); margin-bottom: 2rem; border-left: 4px solid var(--primary);">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                    <div>
                        <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                            <i class="fas fa-clock" style="color: var(--primary); margin-right: 0.5rem;"></i>Start Date & Time
                        </label>
                        <div style="margin-top: 0.75rem; font-size: 1rem; color: var(--gray-900); font-weight: 500;">
                            @Model.StartDateTime.ToString("dddd, MMMM dd, yyyy")
                        </div>
                        <div style="color: var(--gray-600); font-size: 0.875rem;">
                            @Model.StartDateTime.ToString("hh:mm tt")
                        </div>
                    </div>
                    <div>
                        <label style="font-weight: 600; color: var(--gray-700); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em;">
                            <i class="fas fa-flag-checkered" style="color: var(--primary); margin-right: 0.5rem;"></i>End Date & Time
                        </label>
                        <div style="margin-top: 0.75rem; font-size: 1rem; color: var(--gray-900); font-weight: 500;">
                            @Model.EndDateTime.ToString("dddd, MMMM dd, yyyy")
                        </div>
                        <div style="color: var(--gray-600); font-size: 0.875rem;">
                            @Model.EndDateTime.ToString("hh:mm tt")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Duration Info -->
            @{
                var duration = Model.EndDateTime - Model.StartDateTime;
                var days = duration.Days;
                var hours = duration.Hours;
            }
            <div style="padding: 1rem; background: var(--primary); color: white; border-radius: var(--radius); margin-bottom: 2rem; text-align: center; font-weight: 600;">
                <i class="fas fa-hourglass-end" style="margin-right: 0.5rem;"></i>
                Duration: @(days > 0 ? $"{days} day(s), " : "")@hours hour(s)
            </div>

            <!-- Action Buttons -->
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 2px solid var(--gray-200);">
                <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-primary" style="flex: 1; min-width: 150px;">
                    <i class="fas fa-edit" style="margin-right: 0.5rem;"></i> Edit Booking
                </a>
                <a asp-action="Index" class="btn btn-secondary" style="flex: 1; min-width: 150px;">
                    <i class="fas fa-arrow-left" style="margin-right: 0.5rem;"></i> Back to List
                </a>
            </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.BookingId">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</div>